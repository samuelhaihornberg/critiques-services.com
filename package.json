{
  "name": "critiques-services.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext js,jsx",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "typecheck": "tsc --noEmit",
    "pwa:generate-icons": "node scripts/generate-pwa-icons.js",
    "pwa:verify": "node scripts/verify-pwa.js",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "npm run build && npm run pwa:verify && git add -A && git commit -m 'release: v$npm_package_version' && git tag v$npm_package_version && git push && git push --tags",
    "deploy:preview": "npm run build && npx http-server ./dist -p 8080 -o",
    "deploy:pages": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "http-server": "^14.1.1",
    "gh-pages": "^6.1.1"
  },
  "pwa": {
    "name": "Critiques Services",
    "short_name": "Critiques",
    "description": "Plateforme de critiques de services avec preuves vidéo",
    "theme_color": "#1a1a2e",
    "background_color": "#16213e",
    "display": "standalone",
    "orientation": "portrait-primary",
    "scope": "/",
    "start_url": "/",
    "icons": [
      {
        "src": "pwa-192x192.svg",
        "sizes": "192x192",
        "type": "image/svg+xml",
        "purpose": "any maskable"
      },
      {
        "src": "pwa-512x512.svg",
        "sizes": "512x512",
        "type": "image/svg+xml",
        "purpose": "any maskable"
      }
    ]
  }
}